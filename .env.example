# ─── Forge Deployment Settings ───────────────────────────────────────────────
# Private key of the deployer account (with leading 0x)
PRIVATE_KEY=0x...

# ─── Role Addresses ──────────────────────────────────────────────────────────
# These are the Ethereum addresses that will have specific roles in the contract
# For local Anvil testing, use Anvil's default accounts
CERTIFIER_ADDRESS=0x...
QUALITY_CHECKER_ADDRESS=0x...
FREIGHT_FORWARDER_ADDRESS=0x...
EXPORT_CUSTOMS_ADDRESS=0x...
IMPORT_CUSTOMS_ADDRESS=0x...


# ─── Test Accounts (for minting script) ───────────────────────
TEST_BUYER_ADDRESS=0x...
TEST_SELLER_ADDRESS=0x...

# ─── USDT Token Address ──────────────────────────────────────────────────────
# Address of the USDT token contract (or mock USDT for testing)
# For Anvil: Deploy a mock ERC20 contract or use an existing one
USDT_ADDRESS=0x...

# ─── Backend Configuration ────────────────────────────────────────────────────
# RPC endpoint for the blockchain network
RPC_URL=http://127.0.0.1:8545

# Deployed MyContract address (set after deployment)
CONTRACT_ADDRESS=0x...

# ─── MongoDB Connection ───────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/database_name

# ─── Backend Server ──────────────────────────────────────────────────────────
PORT=3000

# ─── Smart Contract Private Keys (for backend role-based signing) ──────────────
# DEPRECATED: Backend should not sign transactions anymore
# CERTIFIER_PK=0x...
# QUALITY_CHECKER_PK=0x...
# FREIGHT_FORWARDER_PK=0x...
# EXPORT_CUSTOMS_PK=0x...
# IMPORT_CUSTOMS_PK=0x...
