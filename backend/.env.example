# ─── Blockchain Configuration ────────────────────────────────────────────────
# RPC endpoint (local Anvil at 8545 or testnet)
RPC_URL=http://127.0.0.1:8545

# Deployed MyContract address (set after deployment with 'forge script')
CONTRACT_ADDRESS=0x...

# ─── MongoDB Configuration ───────────────────────────────────────────────────
# MongoDB connection URI (local or cloud MongoDB Atlas)
MONGO_URI=
# or use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database

# ─── Backend Server Configuration ─────────────────────────────────────────────
# Server port
PORT=3000

